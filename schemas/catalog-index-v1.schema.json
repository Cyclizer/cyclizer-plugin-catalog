{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclizer.local/schemas/plugin-catalog-index-v1.schema.json",
  "title": "Cyclizer Curated Plugin Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "revision", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "$ref": "#/$defs/logicalId" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "generated_at": { "type": "string", "minLength": 1, "maxLength": 128 },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "package_id", "title", "summary", "publisher", "host", "requested_capabilities", "scm", "distribution"],
        "properties": {
          "id": { "$ref": "#/$defs/logicalId" },
          "package_id": { "$ref": "#/$defs/logicalId" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "publisher": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "$ref": "#/$defs/logicalId" },
              "name": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          },
          "host": {
            "type": "object",
            "additionalProperties": false,
            "required": ["api", "os"],
            "properties": {
              "api": { "type": "string", "minLength": 1, "maxLength": 256 },
              "os": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["windows", "linux", "darwin"] }
              }
            }
          },
          "requested_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/logicalId" }
          },
          "scm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "hosting", "repository_uri", "revision"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 32 },
              "hosting": { "type": "string", "minLength": 1, "maxLength": 64 },
              "repository_uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "revision": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          },
          "distribution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "uri", "version", "sha256"],
            "properties": {
              "kind": { "const": "github-release" },
              "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "version": { "$ref": "#/$defs/semver" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "logicalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
